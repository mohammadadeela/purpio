# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000            # the Next.js app
API_URL=http://localhost:4000            # the Fastify API
DATABASE_URL=postgresql://purpio:purpio@localhost:5432/purpio
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-64-random-chars # cookie signing
MASTER_KEY=base64:change-me-32-bytes     # envelope encryption master key (openssl rand -base64 32)

# ---- Firebase Auth (server verifies ID tokens) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                    # keep the \n escapes
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---- AI providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- PayPal (Advanced Checkout + Subscriptions + Vault) ----
PAYPAL_ENV=sandbox                        # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Purpio <hello@purpio.com>"

# ---- Storage (S3-compatible: AWS S3, Cloudflare R2) ----
S3_ENDPOINT=
S3_BUCKET=purpio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_URL=

# ---- Deploy ----
PREVIEW_DOMAIN=purpio.app                # name.purpio.app
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---- Observability ----
SENTRY_DSN=
POSTHOG_KEY=
