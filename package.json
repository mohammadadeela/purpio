{
  "name": "purpio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @purpio/db migrate",
    "db:seed": "pnpm --filter @purpio/db seed",
    "db:studio": "pnpm --filter @purpio/db studio"
  },
  "devDependencies": { "turbo": "^2.1.0", "typescript": "^5.6.0" }
}
